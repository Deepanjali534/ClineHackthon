# Yatra Sathi — Environment Variables
# Copy this file to .env.local

# ── Anthropic Claude API (OPTIONAL) ──────────────────────────────
# Get free key at: https://console.anthropic.com
# Without this: app uses deterministic planner (fully functional)
ANTHROPIC_API_KEY=

# ── App Config ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Yatra Sathi"
