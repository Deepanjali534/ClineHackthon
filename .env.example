# Daily Travel AI — Environment Variables
# Copy this file to .env.local and fill in values

# ─── AI Provider (Anthropic Claude — recommended) ───
# Get free API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── App Config ───
NEXT_PUBLIC_APP_NAME="Daily Travel AI"
NEXT_PUBLIC_DEMO_MODE=true

# ─── No other keys needed! ───
# Weather: Open-Meteo (free, no key)
# Transit: SQLite seeded demo data (Delhi corridor)
# News: Public RSS feeds (no key)
